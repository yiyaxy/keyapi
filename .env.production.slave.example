# Production direct-run environment for a slave node.
# Copy this file to a real secret file such as:
#   /opt/keyapi/config/keyapi-slave-1.env
#
# Use a different PORT and SITE_LABEL for each slave.
# Never commit real .env.* files.

# Runtime
PORT=3002
GIN_MODE=release
DEBUG=false
NODE_TYPE=slave
TZ=Asia/Shanghai
SITE_LABEL=prod-slave-1
FRONTEND_BASE_URL=https://api.example.com

# Security: must match the master node exactly.
SESSION_SECRET=CHANGE_ME_USE_THE_SAME_VALUE_AS_MASTER
CRYPTO_SECRET=CHANGE_ME_USE_THE_SAME_VALUE_AS_MASTER

# Database: must match the master node.
SQL_DSN=postgresql://keyapi:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/keyapi?sslmode=disable
# LOG_SQL_DSN=postgresql://keyapi_log:CHANGE_ME_LOG_DB_PASSWORD@127.0.0.1:5432/keyapi_log?sslmode=disable
SQL_MAX_IDLE_CONNS=40
SQL_MAX_OPEN_CONNS=120
SQL_MAX_LIFETIME=120

# Redis: must match the master node.
REDIS_CONN_STRING=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0
REDIS_POOL_SIZE=50
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60

# Local batch writer. Keep enabled on every API node.
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# Do not enable master-only scheduled jobs on slaves.
UPDATE_TASK=false
# CHANNEL_UPDATE_FREQUENCY=

# Rate limits. Keep these aligned across nodes.
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=600
GLOBAL_WEB_RATE_LIMIT_DURATION=60
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=600
GLOBAL_API_RATE_LIMIT_DURATION=60
TENANT_API_RATE_LIMIT_NUM=1200
TENANT_API_RATE_LIMIT_DURATION=60
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=20
CRITICAL_RATE_LIMIT_DURATION=1200
SEARCH_RATE_LIMIT_ENABLE=true
SEARCH_RATE_LIMIT=30
SEARCH_RATE_LIMIT_DURATION=60

# Relay and upstream HTTP tuning.
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=300
RELAY_MAX_IDLE_CONNS=1000
RELAY_MAX_IDLE_CONNS_PER_HOST=200
TLS_INSECURE_SKIP_VERIFY=false
MAX_REQUEST_BODY_MB=128
STREAM_SCANNER_MAX_BUFFER_MB=128
MAX_FILE_DOWNLOAD_MB=64

# Observability and production safety.
ERROR_LOG_ENABLED=true
ENABLE_PPROF=false
PROMETHEUS_TOKEN=CHANGE_ME_USE_THE_SAME_VALUE_AS_MASTER
DIFY_DEBUG=false
TRUSTED_REDIRECT_DOMAINS=example.com

# Feature switches.
GENERATE_DEFAULT_TOKEN=false
GET_MEDIA_TOKEN=true
GET_MEDIA_TOKEN_NOT_STREAM=false
GEMINI_VISION_MAX_IMAGE_NUM=16
